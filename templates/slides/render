#!/usr/bin/env bash
# Render a week (or everything) and serve it on :8082.
#
#   ./render 03          one week: the fast path while writing
#   ./render             every week
#   ./render examples    the reference deck of classic polls and chart options
#
# The deck and its poll page are served from one origin, which the live polls
# need: http://localhost:8082/week-03/ and .../week-03/poll.html
#
# Phones cannot reach localhost: for a live test, open the deck on this
# machine's network address instead, so the QR code points somewhere a phone
# can get to.
set -euo pipefail
cd "$(dirname "$0")"
source ./_week.sh

target="${1:-}"
port="${PORT:-8082}"

./build "$target"

deck="/"
poll="/poll.html"
if [[ "$target" == "examples" ]]; then
  deck="/template/examples.html"
  poll="/template/poll.html?deck=examples.html"
elif [[ -n "$target" ]]; then
  deck="/$(resolve_week "$target")/"
  poll="${deck}poll.html"
fi

echo
echo "deck  -> http://localhost:${port}${deck}"
echo "poll  -> http://localhost:${port}${poll}"
echo
cd _site && python3 -m http.server "$port"
